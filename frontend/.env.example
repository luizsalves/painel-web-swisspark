# Copie para .env.local e preencha com os dados que a TI devolver do registro
# do aplicativo no Entra ID. O .env.local não entra no repositório.

# Em desenvolvimento o proxy do Vite já encaminha /api para o backend (vite.config.ts).
# Só preencha se a API estiver em outro endereço.
# VITE_API_URL=

VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=api://SEU_CLIENT_ID/access_as_user
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
