# Copie para .env (na raiz) e preencha. O .env está no .gitignore.
#   cp .env.example .env
#
# É o docker compose que lê este arquivo.

# ---- Banco (Postgres contabil) ----
# Vira ConnectionStrings__Contabil dentro do container, que é o mesmo que
# ConnectionStrings:Contabil do keys.json.
#
# Se preferir não repetir a senha aqui, deixe em branco e monte o keys.json:
# veja o bloco "volumes" comentado no docker-compose.yml.
#
# Postgres rodando na própria máquina hospedeira? Use host.docker.internal.
PAINEL_DB_CONNECTION_STRING=Host=SERVIDOR;Port=5432;Database=contabil;Username=USUARIO;Password=SENHA;SSL Mode=Prefer;Trust Server Certificate=true

# Schema da bi_users: "public" hoje, "painel" quando o banco do painel existir.
PAINEL_DB_SCHEMA=public

# Segundos de cache da autorização. 0 = revogação vale no request seguinte.
PAINEL_DB_CACHE_SECONDS=0

# ---- Entra ID (dados que a TI devolve) ----
# Sem eles a aplicação sobe do mesmo jeito e a tela de login avisa o que falta.
PAINEL_ENTRA_TENANT_ID=
PAINEL_ENTRA_CLIENT_ID=
PAINEL_ENTRA_API_SCOPE=api://SEU_CLIENT_ID/access_as_user

# Precisa ser idêntica à redirect URI cadastrada no Entra, incluindo o esquema.
PAINEL_ENTRA_REDIRECT_URI=http://localhost:8080

# ---- Porta publicada na máquina hospedeira ----
PAINEL_PORTA=8080
